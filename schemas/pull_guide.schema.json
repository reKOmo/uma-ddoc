{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pull_guide.schema.json",
  "title": "Pull guide",
  "description": "Pull advice from Luh's Umamusume Support Card Encyclopedia, per Global banner and card (generated/pull_guide.json, written by `pnpm fetch-pull-guide`; its source is in generated/sources.json).",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "banners": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^\\d+$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "googleSheetsSrc": {
              "type": "object",
              "properties": {
                "gid": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d+$"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The sheet tab's id."
                },
                "row": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The row number (1-based)."
                }
              },
              "required": ["gid", "row"],
              "additionalProperties": false,
              "description": "Where the entry is in the sheet, for links to its row."
            },
            "freePulls": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ],
              "description": "Free pulls the banner gives."
            },
            "shouldPull": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(yes|no|free|(whale|dolphin)\\+*)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The \"Should pull?\" pill: yes, no, free, whale or dolphin, with the advice's pluses (\"whale++\"); null when the advice starts with none."
            },
            "comment": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "The line under the pill: the whole advice when it says more than the pill, or long advice without one."
            },
            "advice": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "The notes as one paragraph, led by short advice without a pill (\"With Kitasan\")."
            }
          },
          "required": ["googleSheetsSrc", "freePulls", "shouldPull", "comment", "advice"],
          "additionalProperties": false
        }
      },
      "description": "Advice per Global banner (real in data/global_banners.json, or predicted), then per card featured on it. Whether it's the card's rerun is on the banner (`featured[].new`)."
    },
    "noBanner": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^\\d+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "googleSheetsSrc": {
            "type": "object",
            "properties": {
              "gid": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d+$"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The sheet tab's id."
              },
              "row": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The row number (1-based)."
              }
            },
            "required": ["gid", "row"],
            "additionalProperties": false,
            "description": "Where the entry is in the sheet, for links to its row."
          },
          "freePulls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Free pulls the banner gives."
          },
          "shouldPull": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(yes|no|free|(whale|dolphin)\\+*)$"
              },
              {
                "type": "null"
              }
            ],
            "description": "The \"Should pull?\" pill: yes, no, free, whale or dolphin, with the advice's pluses (\"whale++\"); null when the advice starts with none."
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "The line under the pill: the whole advice when it says more than the pill, or long advice without one."
          },
          "advice": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "The notes as one paragraph, led by short advice without a pill (\"With Kitasan\")."
          },
          "release": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "label": {
                    "description": "\"Event\", \"Story\", \"Friend Points Shop\"…",
                    "type": ["string", "null"]
                  },
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "required": ["label", "date"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "description": "\"Event\", \"Story\", \"Friend Points Shop\"…",
                    "type": ["string", "null"]
                  },
                  "month": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}$"
                  },
                  "part": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["early", "mid", "late"]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["label", "month", "part"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "description": "\"Event\", \"Story\", \"Friend Points Shop\"…",
                    "type": ["string", "null"]
                  },
                  "dateText": {
                    "type": ["string", "null"]
                  }
                },
                "required": ["label", "dateText"],
                "additionalProperties": false
              }
            ],
            "description": "A card on no banner: what it is and when, as the sheet gives it."
          }
        },
        "required": ["googleSheetsSrc", "freePulls", "shouldPull", "comment", "advice", "release"],
        "additionalProperties": false
      },
      "description": "Advice for cards on no gacha banner (event, story and shop cards), per card."
    }
  },
  "required": ["banners", "noBanner"],
  "additionalProperties": false
}
