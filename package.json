{
  "name": "uma-ddoc",
  "version": "0.1.0-beta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:ai": "VITE_AI_PREVIEW=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check",
    "typecheck": "tsc",
    "format": "biome check --write",
    "test": "vitest run --project unit",
    "test:code": "vitest run --project unit --tags-filter='!data'",
    "test:data": "vitest run --project unit --tags-filter=data",
    "test:upstream": "vitest run --project upstream",
    "test:e2e": "playwright test --project phone --project desktop",
    "test:visual": "playwright test --project visual-phone --project visual-desktop",
    "update-cards": "node scripts/update-cards.ts",
    "build-cards": "node scripts/build-cards.ts",
    "build-schemas": "node scripts/build-schemas.ts",
    "clone-upstream": "node scripts/clone-upstream.ts",
    "rank": "node tierlist/cli.ts",
    "scrape-gametora": "node scripts/scrape-gametora.ts",
    "fetch-pull-guide": "node scripts/fetch-pull-guide.ts",
    "fetch-umatl": "node scripts/fetch-umatl.ts",
    "news:latest": "node scripts/fetch-news-latest.ts",
    "news:latest:jp": "node scripts/fetch-news-latest.ts --server jp",
    "news:all": "node scripts/fetch-news-all.ts",
    "news:all:jp": "node scripts/fetch-news-all.ts --server jp",
    "news:umapyoi": "node scripts/fetch-news-umapyoi.ts",
    "news:umapyoi:jp": "node scripts/fetch-news-umapyoi.ts --server jp",
    "news:categories": "node scripts/categorize-news.ts",
    "news:events": "node scripts/list-events.ts",
    "news:merges": "node scripts/list-merges.ts",
    "news:ai": "node scripts/ai-events.ts",
    "gold:review": "node scripts/gold-review.ts",
    "gold:review:jp": "node scripts/gold-review.ts --server jp",
    "news:features": "node scripts/news-features.ts",
    "news:run": "sh scripts/news-run.sh",
    "update-global": "node scripts/update-global.ts",
    "update-jp": "node scripts/update-jp.ts",
    "setup-ml": "uv venv --allow-existing --python 3.13 ml/.venv && uv pip install --python ml/.venv -r ml/requirements.txt",
    "predict-gl": "ml/.venv/bin/python ml/predict.py",
    "predict-gl:backtest": "ml/.venv/bin/python ml/backtest.py",
    "news:categorize": "ml/.venv/bin/python -W ignore ml/categorize.py",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "clsx": "2.1.1",
    "downshift": "^9.4.1",
    "i18next": "27.0.1",
    "i18next-browser-languagedetector": "8.3.0",
    "lucide-react": "^1.70.0",
    "match-sorter": "^8.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "18.0.1",
    "vaul": "1.1.2",
    "wouter": "^3.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fuse.js": "^7.5.0",
    "husky": "9.1.7",
    "jsdom": "^31.0.0",
    "p-retry": "^9.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
