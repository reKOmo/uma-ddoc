{
  "name": "uma-ddoc",
  "version": "0.1.0-beta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run --project unit",
    "test:upstream": "vitest run --project upstream",
    "update-cards": "node scripts/update-cards.js",
    "build-cards": "node scripts/build-cards.js",
    "clone-upstream": "node scripts/clone-upstream.js",
    "rank": "node tierlist/cli.js",
    "scrape-gametora": "node scripts/scrape-gametora.js",
    "fetch-pull-guide": "node scripts/fetch-pull-guide.js",
    "news:latest": "node scripts/fetch-news-latest.js",
    "news:latest:jp": "node scripts/fetch-news-latest.js --server jp",
    "news:all": "node scripts/fetch-news-all.js",
    "news:all:jp": "node scripts/fetch-news-all.js --server jp",
    "news:umapyoi": "node scripts/fetch-news-umapyoi.js",
    "news:umapyoi:jp": "node scripts/fetch-news-umapyoi.js --server jp",
    "news:categories": "node scripts/categorize-news.js",
    "news:events": "node scripts/list-events.js",
    "news:ai": "node scripts/ai-events.js",
    "update-global": "node scripts/update-global.js",
    "update-jp": "node scripts/update-jp.js",
    "setup-ml": "uv venv --allow-existing --python 3.13 ml/.venv && uv pip install --python ml/.venv -r ml/requirements.txt",
    "predict-gl": "ml/.venv/bin/python ml/predict.py",
    "predict-gl:backtest": "ml/.venv/bin/python ml/backtest.py",
    "prepare": "husky"
  },
  "dependencies": {
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "17.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "husky": "9.1.7",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
