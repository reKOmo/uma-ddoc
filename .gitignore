# Dependencies and build output
node_modules/
dist/

# Build-time data, never committed: card data (`pnpm update-cards`), JP banners + card links
# (`pnpm scrape-gametora`) and predictions (`pnpm predict-gl`).
# Committed data lives in data/ instead (Global's banners + card releases, known dates, the
# official news): nothing can regenerate it.
generated/
generated.tmp/

# Upstream clone for `pnpm test:upstream` (`pnpm clone-upstream`)
/upstream/

# Python venv for ml/ (uv venv ml/.venv)
ml/.venv/
__pycache__/
.pytest_cache/

# Images dropped in the project root to read by hand, e.g. the official monthly release
# schedule (its dates go in data/known_dates.json)
/*.jpg
/*.jpeg
/*.png
/*.webp

# Local secrets (e.g. an API key for reading schedule images later)
.env
.env.*

# Logs, test coverage, OS files
*.log
coverage/
.DS_Store
Thumbs.db
